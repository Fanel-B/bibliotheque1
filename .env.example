# Variables lues par docker-compose.yml.
# Copier ce fichier en ".env" (même dossier) puis remplacer les valeurs.
# Le fichier ".env" est ignoré par git : il ne doit jamais être commité.

# Mot de passe de l'utilisateur "postgres" de la base locale.
POSTGRES_PASSWORD=change-moi

# Secrets de signature des jetons JWT : chaînes longues et aléatoires,
# différentes l'une de l'autre. Par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-moi
JWT_REFRESH_SECRET=change-moi-aussi

# Adresse du front Next.js autorisée par CORS.
FRONTEND_URL=http://localhost:3000
