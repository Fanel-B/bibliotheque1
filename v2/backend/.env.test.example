# Base de test JETABLE : elle est entièrement effacée à chaque "npm test".
# Elle doit obligatoirement être sur localhost (garde-fou dans tests/globalSetup.js).
DATABASE_URL=postgresql://postgres:test@localhost:5433/biblio_test

# Secrets factices, seulement pour signer les jetons pendant les tests.
JWT_ACCESS_SECRET=secret-acces-de-test
JWT_REFRESH_SECRET=secret-rafraichissement-de-test
