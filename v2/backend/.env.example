# Copie ce fichier en ".env" et remplis les vraies valeurs.
# Ne jamais committer le fichier ".env" lui-même.

PORT=4000

# Chaîne de connexion fournie par Neon (Postgres) une fois le projet créé.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secrets pour signer les tokens JWT — mets des chaînes longues et aléatoires.
JWT_ACCESS_SECRET=change-moi
JWT_REFRESH_SECRET=change-moi-aussi

# Origine autorisée pour les requêtes du frontend (CORS)
FRONTEND_URL=http://localhost:3000
